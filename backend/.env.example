NODE_ENV=production
PORT=4000

# Use DATABASE_URL on most managed PostgreSQL providers. Set DB_SSL=true when required.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DB_SSL=true

# Alternatively, omit DATABASE_URL and configure these values.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=enkeglobal

# Generate a long random value. Never use the example in production.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Reserved notification recipient for a future server-side email integration.
ENQUIRY_TO_EMAIL=sales@example.com

# Web3Forms access key for sending email notifications from contact form submissions.
# Get your free key at https://web3forms.com
WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Required because the frontend and backend are deployed on different origins.
# Multiple origins can be comma-separated.
CLIENT_ORIGIN=https://www.example.com

# Coolify: mount persistent storage at /app/uploads.
UPLOAD_DIR=/app/uploads

# Optional temporary disk location for Excel imports (must have at least 1 GB free space).
EXCEL_IMPORT_TMP_DIR=/tmp/enkeglobal-excel-imports
