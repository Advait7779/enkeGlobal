{
  "name": "enkeglobal-monorepo",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "install:all": "npm --prefix frontend ci && npm --prefix backend ci",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build",
    "typecheck": "npm --prefix frontend run typecheck",
    "lint": "npm --prefix frontend run lint",
    "test": "npm --prefix backend test",
    "migrate": "npm --prefix backend run migrate",
    "seed": "npm --prefix backend run seed"
  }
}
